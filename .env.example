NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Provider order. Providers without a key are skipped.
LLM_PROVIDER_CHAIN=groq,openrouter,gemini
LLM_PRIMARY_PROVIDER=groq
LLM_FALLBACK_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
# Contributor keys, each under its owner's own quota: <PROVIDER>_API_KEY_<LABEL>, e.g. GROQ_API_KEY_SUM.
# Used in sequence: the next key takes over only when the current one is rate limited.
LLM_KEY_ORDER=owner,sum,edu,33
GROQ_API_KEY_SUM=
GROQ_API_KEY_EDU=
GROQ_API_KEY_33=
OPENROUTER_API_KEY=
LLM_OPENROUTER_FAST_MODEL=google/gemma-4-31b-it:free
LLM_OPENROUTER_REASONING_MODEL=nvidia/nemotron-3-super-120b-a12b:free
LLM_REASONING_MODEL=openai/gpt-oss-120b
LLM_FAST_MODEL=openai/gpt-oss-20b
LLM_GROQ_REASONING_MODEL=openai/gpt-oss-120b
LLM_GROQ_FAST_MODEL=openai/gpt-oss-20b
LLM_GEMINI_REASONING_MODEL=gemini-3.5-flash-lite
LLM_GEMINI_FAST_MODEL=gemini-3.1-flash-lite
LLM_EMBED_MODEL=gemini-embedding-2
# Speech to text (Groq Whisper), cloud read-aloud (Gemini TTS, free tier available) and the
# source guard that finds instructions hidden in uploaded material (Groq).
LLM_STT_MODEL=whisper-large-v3-turbo
LLM_TTS_MODEL=gemini-3.8-flash-lite-tts
LLM_GUARD_MODEL=openai/gpt-oss-safeguard-20b
# Storyboard illustrations use Gemini image models chosen by the admin tier
# (gemini-3.1-flash-lite-image or gemini-3.1-flash-image). They need billing on the Gemini key.
# Daily re-engagement job (vercel.json crons). Vercel sends it as a bearer token. Any long random string.
CRON_SECRET=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
APP_ORIGIN=https://gamora-web.vercel.app
